# Hugging Face dataset (Phase 1)
DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
DATASET_SPLIT=train
DATA_CACHE_DIR=data/cache
USE_DATASET_CACHE=true

# Groq LLM (Phase 4)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# Recommendation limits
TOP_N=5
CANDIDATE_LIMIT=30
ENABLE_FILTER_RELAXATION=true

# Phase 6 — Backend API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000

# Phase 7 — Next.js frontend (copy to frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: point Streamlit at backend API instead of in-process pipeline
# BACKEND_URL=http://localhost:8000
