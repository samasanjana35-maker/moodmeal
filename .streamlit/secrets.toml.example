# Copy to Streamlit Cloud → App settings → Secrets (do not commit real keys).

GROQ_API_KEY = "gsk_your_key_here"

# Optional — split mode (Streamlit UI + separate FastAPI backend)
# DEPLOYMENT_MODE = "split"
# BACKEND_URL = "https://your-api.example.com"

# Optional — model and cache overrides
# LLM_MODEL = "llama-3.3-70b-versatile"
# USE_DATASET_CACHE = "true"
# DATA_CACHE_DIR = "data/cache"
